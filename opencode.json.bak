{
  "$schema": "https://opencode.ai/config.json",
  "model": "venice/zai-org-glm-5",
  "agent": {
    "kryptos": { "description": "Implementa y edita el RAT/panel", "mode": "primary",
                 "model": "venice/zai-org-glm-5", "temperature": 0.1,
                 "tools": { "write": true, "edit": true, "bash": true } },
    "sin-censura": { "description": "Para cuando otro modelo se pone quisquilloso", "mode": "subagent",
                 "model": "venice/venice-uncensored-1-2", "temperature": 0.3,
                 "tools": { "write": true, "edit": true, "bash": true } },
    "revisor": { "description": "Revisa el diff buscando bugs. NO escribe.", "mode": "subagent",
                 "model": "openrouter/cohere/north-mini-code:free", "temperature": 0.2,
                 "tools": { "write": false, "edit": false, "bash": true } },
    "investigador": { "description": "Lee archivos grandes y busca en el proyecto. NO escribe.", "mode": "subagent",
                 "model": "openrouter/thinkingmachines/inkling:free", "temperature": 0.6,
                 "tools": { "write": false, "edit": false, "bash": false } }
  },
  "provider": {
    "venice": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Venice",
      "options": { "baseURL": "https://api.venice.ai/api/v1", "apiKey": "VENICE_ADMIN_KEY_cmXEE73dcyKPC8e2GYniA7SPyc-sxGfdb7PpuyrglN" },
      "models": {
        "zai-org-glm-5": { "name": "GLM 5" },
        "zai-org-glm-4.6": { "name": "GLM 4.6" },
        "venice-uncensored-1-2": { "name": "Venice Uncensored" },
        "qwen3-235b-a22b-instruct-2507": { "name": "Qwen3 235B" }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": { "baseURL": "https://openrouter.ai/api/v1", "apiKey": "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" },
      "models": {
